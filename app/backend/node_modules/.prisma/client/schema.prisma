// This is your Prisma schema file for GoPooL
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  rider
  driver
  both
  admin
}

enum UserStatus {
  active
  suspended
  banned
  deleted
}

enum GenderType {
  male
  female
  other
  prefer_not_to_say
}

enum DocumentType {
  cnic
  driving_license
  vehicle_registration
  insurance
}

enum DocumentStatus {
  pending
  approved
  rejected
}

enum RideStatus {
  scheduled
  ongoing
  completed
  cancelled
}

enum RideRequestStatus {
  pending
  accepted
  rejected
  cancelled
  expired
}

enum RidePassengerStatus {
  confirmed
  picked_up
  completed
  cancelled
  no_show
}

enum ReportReason {
  harassment
  unsafe_driving
  no_show
  payment_issue
  other
}

enum ReportStatus {
  open
  investigating
  resolved
  dismissed
}

enum ChatType {
  ride_group
  direct
}

enum MessageType {
  text
  image
  location
  system
}

enum NotificationType {
  ride_request
  ride_accepted
  ride_cancelled
  chat_message
  system
}

enum DevicePlatform {
  android
  ios
  web
}

// ==========================================
// Models
// ==========================================

// 1. Users
model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String?    @unique @db.VarChar(255)
  phoneNumber      String?    @unique @map("phone_number") @db.VarChar(20)
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  role             UserRole   @default(rider)
  status           UserStatus @default(active)
  isPhoneVerified  Boolean    @default(false) @map("is_phone_verified")
  isEmailVerified  Boolean    @default(false) @map("is_email_verified")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz()
  refreshTokenHash String?    @map("refresh_token_hash")

  // Relations
  profile           Profile?
  vehicles          Vehicle[]
  rides             Ride[]
  rideRequests      RideRequest[]
  ridePassengers    RidePassenger[]
  ratingsGiven      Rating[]          @relation("RaterRelation")
  ratingsReceived   Rating[]          @relation("RateeRelation")
  reportsSubmitted  Report[]          @relation("ReporterRelation")
  reportsReceived   Report[]          @relation("ReportedUserRelation")
  chatParticipants  ChatParticipant[]
  messagesSent      Message[]
  notifications     Notification[]
  devices           Device[]
  savedLocations    SavedLocation[]
  documentsUploaded Document[]        @relation("DocumentUploaderRelation")
  documentsReviewed Document[]        @relation("DocumentReviewerRelation")

  @@map("users")
}

// 2. Profiles
model Profile {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String     @unique @map("user_id") @db.Uuid
  firstName             String     @map("first_name") @db.VarChar(100)
  lastName              String     @map("last_name") @db.VarChar(100)
  gender                GenderType @default(prefer_not_to_say)
  dateOfBirth           DateTime?  @map("date_of_birth") @db.Date
  profilePictureUrl     String?    @map("profile_picture_url")
  bio                   String?
  emergencyContactName  String?    @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String?    @map("emergency_contact_phone") @db.VarChar(20)
  ratingAvg             Decimal    @default(5.00) @map("rating_avg") @db.Decimal(3, 2)
  totalRidesCompleted   Int        @default(0) @map("total_rides_completed")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// 3. Documents
model Document {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  docType     DocumentType   @map("doc_type")
  documentUrl String         @map("document_url")
  status      DocumentStatus @default(pending)
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?      @map("reviewed_at") @db.Timestamptz()
  submittedAt DateTime       @default(now()) @map("submitted_at") @db.Timestamptz()

  // Relations
  uploader User  @relation("DocumentUploaderRelation", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("DocumentReviewerRelation", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("documents")
}

// 4. VehicleTypes
model VehicleType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  maxCapacity Int      @map("max_capacity")
  baseFare    Decimal  @default(0.00) @map("base_fare") @db.Decimal(10, 2)
  perKmRate   Decimal  @default(0.00) @map("per_km_rate") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  vehicles Vehicle[]

  @@map("vehicle_types")
}

// 5. Vehicles
model Vehicle {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId      String   @map("driver_id") @db.Uuid
  vehicleTypeId String   @map("vehicle_type_id") @db.Uuid
  make          String   @db.VarChar(50)
  model         String   @db.VarChar(50)
  year          Int
  color         String   @db.VarChar(30)
  plateNumber   String   @unique @map("plate_number") @db.VarChar(20)
  seatCapacity  Int      @map("seat_capacity")
  isVerified    Boolean  @default(false) @map("is_verified")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  driver      User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  rides       Ride[]

  @@index([driverId])
  @@index([vehicleTypeId])
  @@map("vehicles")
}

// 6. Rides
model Ride {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId             String     @map("driver_id") @db.Uuid
  vehicleId            String     @map("vehicle_id") @db.Uuid
  originAddress        String     @map("origin_address")
  originLat            Decimal    @map("origin_lat") @db.Decimal(9, 6)
  originLng            Decimal    @map("origin_lng") @db.Decimal(9, 6)
  destinationAddress   String     @map("destination_address")
  destinationLat       Decimal    @map("destination_lat") @db.Decimal(9, 6)
  destinationLng       Decimal    @map("destination_lng") @db.Decimal(9, 6)
  departureTime        DateTime   @map("departure_time") @db.Timestamptz()
  estimatedArrivalTime DateTime?  @map("estimated_arrival_time") @db.Timestamptz()
  availableSeats       Int        @map("available_seats")
  pricePerSeat         Decimal    @map("price_per_seat") @db.Decimal(10, 2)
  routePolyline        String?    @map("route_polyline")
  status               RideStatus @default(scheduled)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  driver         User            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  rideStops      RideStop[]
  rideRequests   RideRequest[]
  ridePassengers RidePassenger[]
  ratings        Rating[]
  reports        Report[]
  chat           Chat?

  @@index([driverId])
  @@index([vehicleId])
  @@index([originLat, originLng])
  @@index([destinationLat, destinationLng])
  @@map("rides")
}

// 7. RideStops
model RideStop {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId               String    @map("ride_id") @db.Uuid
  sequenceNo           Int       @map("sequence_no")
  address              String
  lat                  Decimal   @db.Decimal(9, 6)
  lng                  Decimal   @db.Decimal(9, 6)
  estimatedArrivalTime DateTime? @map("estimated_arrival_time") @db.Timestamptz()

  // Relations
  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([lat, lng])
  @@map("ride_stops")
}

// 8. RideRequests
model RideRequest {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId         String            @map("ride_id") @db.Uuid
  passengerId    String            @map("passenger_id") @db.Uuid
  pickupAddress  String            @map("pickup_address")
  pickupLat      Decimal           @map("pickup_lat") @db.Decimal(9, 6)
  pickupLng      Decimal           @map("pickup_lng") @db.Decimal(9, 6)
  dropoffAddress String            @map("dropoff_address")
  dropoffLat     Decimal           @map("dropoff_lat") @db.Decimal(9, 6)
  dropoffLng     Decimal           @map("dropoff_lng") @db.Decimal(9, 6)
  seatsRequested Int               @default(1) @map("seats_requested")
  status         RideRequestStatus @default(pending)
  requestedAt    DateTime          @default(now()) @map("requested_at") @db.Timestamptz()
  respondedAt    DateTime?         @map("responded_at") @db.Timestamptz()

  // Relations
  ride          Ride           @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger     User           @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  ridePassenger RidePassenger?

  @@index([rideId])
  @@index([passengerId])
  @@index([pickupLat, pickupLng])
  @@index([dropoffLat, dropoffLng])
  @@map("ride_requests")
}

// 9. RidePassengers
model RidePassenger {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId        String              @map("ride_id") @db.Uuid
  rideRequestId String?             @unique @map("ride_request_id") @db.Uuid
  passengerId   String              @map("passenger_id") @db.Uuid
  seatCount     Int                 @default(1) @map("seat_count")
  pickupPoint   String              @map("pickup_point")
  dropoffPoint  String              @map("dropoff_point")
  fareAmount    Decimal             @map("fare_amount") @db.Decimal(10, 2)
  status        RidePassengerStatus @default(confirmed)
  pickupOtpPin  String?             @map("pickup_otp_pin") @db.VarChar(6)
  joinedAt      DateTime            @default(now()) @map("joined_at") @db.Timestamptz()

  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  // Relations
  ride        Ride         @relation(fields: [rideId], references: [id], onDelete: Restrict)
  rideRequest RideRequest? @relation(fields: [rideRequestId], references: [id], onDelete: SetNull)
  passenger   User         @relation(fields: [passengerId], references: [id], onDelete: Restrict)

  @@index([rideId])
  @@index([passengerId])
  @@map("ride_passengers")
}

// 10. Ratings
model Rating {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId      String   @map("ride_id") @db.Uuid
  raterId     String   @map("rater_id") @db.Uuid
  rateeId     String   @map("ratee_id") @db.Uuid
  ratingValue Int      @map("rating_value")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rater User @relation("RaterRelation", fields: [raterId], references: [id], onDelete: Cascade)
  ratee User @relation("RateeRelation", fields: [rateeId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([rateeId])
  @@map("ratings")
}

// 11. Reports
model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  reportedUserId String?      @map("reported_user_id") @db.Uuid
  rideId         String?      @map("ride_id") @db.Uuid
  reason         ReportReason
  description    String
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz()

  // Relations
  reporter     User  @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUserRelation", fields: [reportedUserId], references: [id], onDelete: Cascade)
  ride         Ride? @relation(fields: [rideId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@map("reports")
}

// 12. Chats
model Chat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rideId    String?  @unique @map("ride_id") @db.Uuid
  type      ChatType @default(direct)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  ride         Ride?             @relation(fields: [rideId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     Message[]

  @@map("chats")
}

// 13. ChatParticipants
model ChatParticipant {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId   String    @map("chat_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz()
  leftAt   DateTime? @map("left_at") @db.Timestamptz()
  isMuted  Boolean   @default(false) @map("is_muted")

  // Relations
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_participants")
}

// 14. Messages
model Message {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId      String      @map("chat_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  content     String?
  messageType MessageType @default(text) @map("message_type")
  mediaUrl    String?     @map("media_url")
  sentAt      DateTime    @default(now()) @map("sent_at") @db.Timestamptz()
  isRead      Boolean     @default(false) @map("is_read")

  // Relations
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([sentAt])
  @@map("messages")
}

// 15. Notifications
model Notification {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  type              NotificationType
  title             String           @db.VarChar(150)
  body              String
  relatedEntityType String?          @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?          @map("related_entity_id") @db.Uuid
  isRead            Boolean          @default(false) @map("is_read")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// 16. Devices
model Device {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  pushToken    String         @unique @map("push_token")
  platform     DevicePlatform
  lastActiveAt DateTime       @default(now()) @map("last_active_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// 17. SavedLocations
model SavedLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(50)
  address   String
  lat       Decimal  @db.Decimal(9, 6)
  lng       Decimal  @db.Decimal(9, 6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_locations")
}
